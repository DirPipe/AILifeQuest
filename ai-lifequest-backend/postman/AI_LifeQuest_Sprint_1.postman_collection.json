            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('userId')) {",
                  "  throw new Error('Falta userId. Ejecuta primero Register user o Login user.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get user returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('User has totalXp', function () {",
                  "  pm.expect(pm.response.json().totalXp).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users?userId={{userId}}"
