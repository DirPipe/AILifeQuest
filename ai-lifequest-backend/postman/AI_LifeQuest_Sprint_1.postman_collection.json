      "name": "Auth",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Register response has userId and email', function () {",
                  "  pm.expect(json.userId).to.be.a('string');",
                  "  pm.expect(json.email).to.be.a('string');",
                  "});",
                  "pm.environment.set('userId', json.userId);",
                  "pm.environment.set('email', json.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"test.user+{{$timestamp}}@example.com\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('email')) {",
                  "  throw new Error('Falta email. Ejecuta primero Register user.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
